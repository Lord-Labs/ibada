{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "website",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ibada-gamma.vercel.app" }],
      "destination": "https://ibada.lordlabs.tech/:path*",
      "permanent": true
    }
  ]
}
